{
  "id": "aws-cloudtrail-pipeline",
  "description": "Route CloudTrail logs to Sentinel workspace",
  "routes": [
    {
      "id": "cloudtrail-to-sentinel",
      "filter": "event.source == 'CloudTrail'",
      "output": "sentinel-http"
    }
  ],
  "outputs": {
    "sentinel-http": {
      "type": "http",
      "url": "https://<workspace-id>.ods.opinsights.azure.com/api/logs",
      "headers": {
        "Content-Type": "application/json",
        "Log-Type": "CriblCloudTrail"
      }
    }
  }
}
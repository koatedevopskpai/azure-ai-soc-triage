{
  "id": "cribl-local-sim",
  "description": "Local Cribl Lite simulation: sample logs -> filter -> normalize -> console/file",
  "routes": [
    {
      "id": "filter-noise",
      "filter": "!contains(event.message, 'healthcheck') && event.severity != 'debug'",
      "output": "normalize"
    }
  ],
  "inputs": {
    "file": {
      "type": "file",
      "path": "/data/sample_logs.json"
    }
  },
  "processors": {
    "normalize": {
      "type": "eval",
      "name": "Normalize fields",
      "eval": [
        "event._time = Date.parse(event.ts) / 1000",
        "event.sourcetype = event.source",
        "event.host = event.computer || event.hostname"
      ]
    }
  },
  "outputs": {
    "file": {
      "type": "file",
      "path": "/data/normalized_output.jsonl"
    }
  }
}